// ---------------------------------------------------------------------------
// SocietyDesk / PG & Hostel Manager - Prisma schema
//
// Multi-tenant database supporting both PG/Hostel (rooms, beds, occupancies, deposits)
// and Apartment Society (flats, flat_residents, committee governance) workspaces.
// Enum-like fields remain String; allowed values are enforced in JS by lib/constants.js + zod.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// 12.1 Society / Tenant (the root tenant entity)
// ---------------------------------------------------------------------------
model Society {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      String   @default("PG") // PG | SOCIETY
  rentCycle String   @default("CALENDAR") // CALENDAR | JOIN_DATE
  dueDay    Int      @default(5)
  lateFee   Int      @default(0)
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  logoUrl   String?
  bankName        String?
  bankAccountNo   String?
  bankIfsc        String?
  bankHolderName  String?
  upiId           String?
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  buildings       Building[]
  units           Unit[]
  beds            Bed[]
  occupancies     Occupancy[]
  deposits        Deposit[]
  tenantDocuments TenantDocument[]
  flats           Flat[]
  feeConfigs      FeeConfiguration[]
  invoices        Invoice[]
  payments        Payment[]
  paymentOrders   PaymentOrder[]
  receipts        Receipt[]
  complaints      Complaint[]
  notices         Notice[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([type])
}

// ---------------------------------------------------------------------------
// 12.2 User
// ---------------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  societyId String?
  authUid   String?  @unique // Firebase UID, linked on first login
  name      String
  email     String   @unique
  phone     String?
  role      String   @default("RESIDENT") // SUPER_ADMIN | OWNER | MANAGER | RESIDENT | SOCIETY_ADMIN | FLAT_ADMIN
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)

  occupancies            Occupancy[]
  tenantDocuments        TenantDocument[]
  flatResidents          FlatResident[]
  invoices               Invoice[]        @relation("InvoiceCreatedBy")
  paymentsMade           Payment[]        @relation("PaymentRecordedBy")
  paymentOrdersInitiated PaymentOrder[]
  complaintsMade         Complaint[]      @relation("ComplaintCreatedBy")
  complaintsAssigned     Complaint[]      @relation("ComplaintAssignedTo")
  complaintComments      ComplaintComment[]
  noticesPosted          Notice[]         @relation("NoticePostedBy")
  noticeReads            NoticeRead[]
  auditLogs              AuditLog[]
  pushSubscriptions      PushSubscription[]

  @@index([societyId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// PG / Hostel Hierarchy: Building -> Unit (Room) -> Bed -> Occupancy
// ---------------------------------------------------------------------------

model Building {
  id        String   @id @default(cuid())
  societyId String
  name      String
  floors    Int?     @default(1)
  createdAt DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  units   Unit[]

  @@index([societyId])
}

model Unit {
  id               String   @id @default(cuid())
  societyId        String
  buildingId       String?
  unitNumber       String   // e.g. "101", "102", "201"
  floor            String?  // "1", "2"
  unitType         String   @default("DOUBLE") // SINGLE | DOUBLE | TRIPLE | DORM | FLAT
  bedCapacity      Int      @default(2)
  rentAmount       Int      @default(0) // Default monthly rent
  ac               Boolean  @default(false)
  attachedBathroom Boolean  @default(true)
  status           String   @default("AVAILABLE") // AVAILABLE | FULL | MAINTENANCE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  society     Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  building    Building?   @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  beds        Bed[]
  occupancies Occupancy[]
  complaints  Complaint[]

  @@unique([societyId, unitNumber])
  @@index([societyId, status])
}

model Bed {
  id         String   @id @default(cuid())
  societyId  String
  unitId     String
  bedLabel   String   // "A", "B", "C"
  rentAmount Int?     // overrides unit rent if set
  status     String   @default("VACANT") // VACANT | OCCUPIED | RESERVED | MAINTENANCE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  society     Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  occupancies Occupancy[]
  complaints  Complaint[]

  @@unique([unitId, bedLabel])
  @@index([societyId, status])
}

model Occupancy {
  id               String    @id @default(cuid())
  societyId        String
  userId           String
  unitId           String
  bedId            String?
  joinDate         DateTime  @default(now())
  leaveDate        DateTime?
  monthlyRent      Int       @default(0)
  depositAmount    Int       @default(0)
  noticePeriodDays Int       @default(30)
  status           String    @default("ACTIVE") // ACTIVE | NOTICE | LEFT
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit          Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bed           Bed?           @relation(fields: [bedId], references: [id], onDelete: SetNull)
  deposits      Deposit[]
  invoices      Invoice[]
  payments      Payment[]
  paymentOrders PaymentOrder[]

  @@index([societyId, status])
  @@index([userId])
  @@index([unitId])
}

model TenantDocument {
  id                 String   @id @default(cuid())
  societyId          String
  userId             String
  docType            String   // AADHAAR | PAN | COLLEGE_ID | OFFICE_ID | OTHER
  cloudinaryPublicId String?
  fileUrl            String
  resourceType       String   @default("image")
  uploadedBy         String?
  createdAt          DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([societyId, userId])
}

model Deposit {
  id              String    @id @default(cuid())
  societyId       String
  occupancyId     String
  amountReceived  Int       @default(0)
  receivedDate    DateTime  @default(now())
  deductionsTotal Int       @default(0)
  refundAmount    Int       @default(0)
  refundDate      DateTime?
  status          String    @default("HELD") // HELD | PARTIALLY_REFUNDED | REFUNDED
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  society    Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  occupancy  Occupancy          @relation(fields: [occupancyId], references: [id], onDelete: Cascade)
  deductions DepositDeduction[]

  @@index([societyId, status])
  @@index([occupancyId])
}

model DepositDeduction {
  id        String   @id @default(cuid())
  depositId String
  reason    String
  amount    Int
  createdAt DateTime @default(now())

  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@index([depositId])
}

// ---------------------------------------------------------------------------
// Society Model: Flats & Flat Residents
// ---------------------------------------------------------------------------

model Flat {
  id          String   @id @default(cuid())
  societyId   String
  flatNumber  String
  block       String?
  floor       String?
  flatType    String? // 1 BHK | 2 BHK | 3 BHK | 4 BHK | PENTHOUSE | SHOP
  sqFt        Int?
  parkingSlot String?
  status      String   @default("OCCUPIED") // OCCUPIED | VACANT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  residents     FlatResident[]
  invoices      Invoice[]
  payments      Payment[]
  paymentOrders PaymentOrder[]
  complaints    Complaint[]

  @@unique([societyId, flatNumber])
  @@index([societyId, status])
}

model FlatResident {
  id           String    @id @default(cuid())
  societyId    String
  flatId       String
  userId       String
  residentType String    @default("OWNER") // OWNER | TENANT
  isPrimary    Boolean   @default(false)
  startDate    DateTime  @default(now())
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flatId, userId])
  @@index([societyId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Billing: FeeConfiguration, Invoice, InvoiceItem, Payment, PaymentOrder, Receipt
// ---------------------------------------------------------------------------

model FeeConfiguration {
  id                   String   @id @default(cuid())
  societyId            String
  name                 String
  type                 String   @default("MAINTENANCE") // RENT | MAINTENANCE | PARKING | WATER | FOOD | LAUNDRY | ELECTRICITY | OTHER
  calculationType      String   @default("FIXED") // FIXED | PER_SQFT | FLAT_TYPE
  amount               Int      @default(0)
  rate                 Float?
  flatTypeAmounts      String?
  frequency            String   @default("MONTHLY") // MONTHLY | QUARTERLY | ANNUAL | ONE_TIME
  appliesToParkingOnly Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, active])
}

model Invoice {
  id            String   @id @default(cuid())
  societyId     String
  flatId        String?
  occupancyId   String?
  billableType  String   @default("OCCUPANCY") // OCCUPANCY | FLAT
  invoiceNumber String
  billingPeriod String   // "2026-10"
  invoiceDate   DateTime @default(now())
  dueDate       DateTime
  subtotal      Int      @default(0)
  previousDue   Int      @default(0)
  penalty       Int      @default(0)
  discount      Int      @default(0)
  totalAmount   Int      @default(0)
  paidAmount    Int      @default(0)
  status        String   @default("PENDING") // PENDING | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat          Flat?          @relation(fields: [flatId], references: [id], onDelete: Cascade)
  occupancy     Occupancy?     @relation(fields: [occupancyId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]
  paymentOrders PaymentOrder[]
  createdBy     User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  @@unique([societyId, invoiceNumber])
  @@index([societyId, status])
  @@index([societyId, dueDate])
  @@index([societyId, occupancyId, billingPeriod])
  @@index([societyId, flatId, billingPeriod])
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String
  name      String
  type      String // RENT | ELECTRICITY | WATER | FOOD | LAUNDRY | MAINTENANCE | LATE_FEE | DEPOSIT | OTHER
  amount    Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                   String   @id @default(cuid())
  societyId            String
  invoiceId            String
  flatId               String?
  occupancyId          String?
  amount               Int
  paymentMethod        String // CASH | CHEQUE | BANK_TRANSFER | UPI | RAZORPAY | OTHER
  transactionReference String?
  paymentDate          DateTime @default(now())
  notes                String?
  proofUrl             String?
  proofPublicId        String?
  recordedById         String?
  orderId              String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  society    Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  flat       Flat?         @relation(fields: [flatId], references: [id], onDelete: Cascade)
  occupancy  Occupancy?    @relation(fields: [occupancyId], references: [id], onDelete: SetNull)
  recordedBy User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  order      PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receipts   Receipt[]

  @@index([societyId, paymentDate])
  @@index([invoiceId])
  @@index([occupancyId])
}

model PaymentOrder {
  id               String    @id @default(cuid())
  societyId        String
  invoiceId        String
  flatId           String?
  occupancyId      String?
  initiatedById    String
  amount           Int
  currency         String    @default("INR")
  gateway          String // RAZORPAY | MOCK
  status           String    @default("CREATED") // CREATED | PAID | FAILED | EXPIRED
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  gatewayMethod    String?
  failureReason    String?
  receiptUrl       String?
  expiresAt        DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  society     Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  flat        Flat?      @relation(fields: [flatId], references: [id], onDelete: Cascade)
  occupancy   Occupancy? @relation(fields: [occupancyId], references: [id], onDelete: SetNull)
  initiatedBy User       @relation(fields: [initiatedById], references: [id])
  payment     Payment?

  @@unique([gateway, gatewayOrderId])
  @@index([societyId, status])
  @@index([invoiceId])
  @@index([flatId])
  @@index([occupancyId])
}

model Receipt {
  id            String   @id @default(cuid())
  societyId     String
  paymentId     String
  receiptNumber String
  pdfUrl        String?
  createdAt     DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId])
  @@index([societyId, receiptNumber])
}

// ---------------------------------------------------------------------------
// Complaints & Timeline
// ---------------------------------------------------------------------------

model Complaint {
  id              String    @id @default(cuid())
  societyId       String
  flatId          String?
  unitId          String?
  bedId           String?
  createdById     String
  category        String // PLUMBING | ELECTRICAL | CLEANLINESS | PARKING | SECURITY | NOISE | WATER | WIFI | OTHER
  title           String
  description     String
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status          String    @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | RESOLVED | CLOSED | REOPENED
  assignedToId    String?
  resolutionNotes String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  society     Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat        Flat?                 @relation(fields: [flatId], references: [id], onDelete: Cascade)
  unit        Unit?                 @relation(fields: [unitId], references: [id], onDelete: SetNull)
  bed         Bed?                  @relation(fields: [bedId], references: [id], onDelete: SetNull)
  createdBy   User                  @relation("ComplaintCreatedBy", fields: [createdById], references: [id])
  assignedTo  User?                 @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id])
  attachments ComplaintAttachment[]
  comments    ComplaintComment[]

  @@index([societyId, status])
  @@index([flatId])
  @@index([unitId])
}

model ComplaintAttachment {
  id                 String   @id @default(cuid())
  societyId          String
  complaintId        String
  fileUrl            String
  fileName           String
  cloudinaryPublicId String?
  resourceType       String   @default("image")
  createdAt          DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model ComplaintComment {
  id          String   @id @default(cuid())
  societyId   String
  complaintId String
  userId      String
  comment     String
  eventType   String   @default("COMMENT") // COMMENT | STATUS_CHANGE | ASSIGNMENT
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
}

// ---------------------------------------------------------------------------
// Notices & Read Receipts
// ---------------------------------------------------------------------------

model Notice {
  id                 String    @id @default(cuid())
  societyId          String
  title              String
  body               String
  category           String    @default("GENERAL") // GENERAL | URGENT | MAINTENANCE | EVENT | RULES
  attachmentUrl      String?
  attachmentPublicId String?
  attachmentName     String?
  postedById         String
  status             String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  society  Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  postedBy User         @relation("NoticePostedBy", fields: [postedById], references: [id])
  reads    NoticeRead[]

  @@index([societyId, status])
}

model NoticeRead {
  id        String   @id @default(cuid())
  societyId String
  noticeId  String
  userId    String
  readAt    DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([societyId])
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  societyId  String?
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  reason     String?
  createdAt  DateTime @default(now())

  society Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([societyId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Web Push Notifications
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  societyId String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([societyId])
}