# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Dev default is SQLite so the app runs with zero setup.
# For production/PostgreSQL change the datasource in prisma/schema.prisma to:
#   provider = "postgresql"
#   url      = env("DATABASE_URL")
# and use a postgres:// connection string here.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Dev auth bypass  (LOCAL DEVELOPMENT ONLY)
# ---------------------------------------------------------------------------
# When true, /login shows a "login as" role picker and no Firebase project is
# needed. When false, real Firebase ID tokens are required.
# NEVER set this to true in production.
DEV_AUTH_BYPASS="true"

# Seeded dev accounts created by `npm run db:seed`
DEV_SUPER_ADMIN_EMAIL="superadmin@societydesk.local"
DEV_ADMIN_EMAIL="admin@greenvalley.local"
DEV_RESIDENT_EMAIL="ravi@greenvalley.local"

# ---------------------------------------------------------------------------
# Firebase client SDK
# ---------------------------------------------------------------------------
# Not configured here: the web config lives in lib/firebase/config.js, which is
# safe to commit because those values are public by design.

# ---------------------------------------------------------------------------
# Firebase Admin SDK  (server only - never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Optional. Only needed for privileged Admin calls (user management, revocation
# checks). Without it ID tokens are still verified using the project id from
# lib/firebase/config.js.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the private key with literal \n sequences, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE..."
FIREBASE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Cloudinary (complaint photos, notice attachments, payment proofs, receipts)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Online payments - Razorpay
# ---------------------------------------------------------------------------
# Leave PAYMENT_GATEWAY_MODE on "auto" (or omit it) until you have test keys:
# the app then runs a built-in mock gateway so the whole pay -> verify ->
# receipt flow works with no Razorpay account and no real money.
#
#   auto  - use Razorpay when both keys are present, otherwise mock (default)
#   mock  - always simulate; handy for demos and local testing
#   live  - require real keys and fail loudly if they are missing
#
# When you are ready for the real gateway, create a Razorpay account, switch to
# Test Mode, copy the key id and secret from Settings -> API Keys, and set:
PAYMENT_GATEWAY_MODE="auto"

# Test-mode keys from Razorpay. The key id is public (it is embedded in the
# checkout widget); the SECRET must never reach the browser or a NEXT_PUBLIC_
# variable, since it signs payment confirmations.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional. Only for the browser checkout widget; falls back to RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Optional. Razorpay Dashboard -> Webhooks -> "payment captured". Used to verify
# that a webhook really came from Razorpay. Without it, webhook authenticity is
# still enforced by re-reading the payment from Razorpay's API.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"